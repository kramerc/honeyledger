#!/usr/bin/env ruby
# frozen_string_literal: true

# Start on a port derived from this checkout, so servers started from parallel
# worktrees do not collide and each worktree keeps a stable URL between runs.
# The primary checkout prefers 3000. Set PORT to pin one explicitly.
unless ENV["PORT"] || ARGV.any? { |argument| argument.start_with?("-p", "--port") }
  require "socket"
  require File.expand_path("../config/worktree_database", __dir__)

  preferred = WorktreeDatabase.preferred_port(File.expand_path("..", __dir__))

  # Distinct worktrees prefer distinct ports, but two can still hash to the
  # same one, so fall forward to the next free port.
  port = (preferred..preferred + 50).find do |candidate|
    TCPServer.new("127.0.0.1", candidate).close
    true
  rescue Errno::EADDRINUSE, Errno::EACCES
    false
  end

  if port
    ENV["PORT"] = port.to_s
    warn "=> Port #{preferred} is taken; starting on #{port}" unless port == preferred
  end
end

exec "./bin/rails", "server", *ARGV
