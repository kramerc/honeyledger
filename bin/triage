#!/usr/bin/env ruby
# frozen_string_literal: true

# Reads and sets the Priority, Size, and Estimate fields of this repository's
# issues on the "Honeyledger" Projects v2 board. The rubric for choosing values is the
# triage-issues skill (.agents/skills/triage-issues/SKILL.md); this script only
# talks to GitHub. Project, field, and option IDs are looked up by name on
# every run, so nothing breaks when the board is edited.
#
#   bin/triage list [--all] [--json]                          # open issues needing triage (--all: every open issue)
#   bin/triage set N [--priority P0|P1|P2] [--size XS|S|M|L|XL] [--force]
#   bin/triage sync-estimates [--dry-run]                     # derive Estimate from Size (cleared on parents) wherever it differs
#
# `set` adds the issue to the board if it is not there yet, and refuses to
# replace a Priority or Size that is already set (the maintainer's call)
# unless --force is given. Estimate is never set by hand: it is derived from Size
# (ProjectBoard::ESTIMATES) whenever an issue's Size is written or checked,
# and `list` flags an issue whose Estimate is missing or does not match (`!`).
# A parent issue (one with sub-issues) has its Estimate cleared instead, since
# its sub-issues carry the points, and needs no Size.
# Needs a gh token with the `project` scope.
#
# The parsing lives in lib/dev/project_board.rb, which has tests.

require "json"

APP_ROOT = File.expand_path("..", __dir__)
require File.join(APP_ROOT, "lib", "dev", "project_board")

USAGE = File.read(__FILE__).lines.grep(/\A#   bin\/triage/).map { |line| line.delete_prefix("# ") }.join.freeze

def gh(*args, input: nil)
  output = IO.popen([ "gh", *args ], "r+", chdir: APP_ROOT) do |io|
    io.write(input) if input
    io.close_write
    io.read
  end
  abort "gh #{args.take(2).join(" ")} failed (does the token have the project scope? `gh auth refresh -s project`)" unless $?.success?
  output
end

def graphql(query, **variables)
  args = [ "api", "graphql", "-f", "query=#{query}" ]
  # -F sends numbers as numbers; -f keeps IDs and option names as strings.
  variables.each { |name, value| args.push(value.is_a?(Numeric) ? "-F" : "-f", "#{name}=#{value}") }
  JSON.parse(gh(*args)).fetch("data")
end

def option_value(options, flag)
  index = options.index(flag) or return nil
  options[index + 1] or abort("#{flag} needs a value\n#{USAGE}")
end

command, *options = ARGV
abort USAGE unless %w[list set sync-estimates].include?(command)

repository = JSON.parse(gh("repo", "view", "--json", "nameWithOwner,owner"))
owner = repository.dig("owner", "login")

projects = graphql(<<~GRAPHQL, login: owner, title: ProjectBoard::PROJECT_TITLE)
  query($login: String!, $title: String!) {
    repositoryOwner(login: $login) {
      ... on ProjectV2Owner { projectsV2(first: 20, query: $title) { nodes { id title } } }
    }
  }
GRAPHQL
project = projects.dig("repositoryOwner", "projectsV2", "nodes").to_a.find { |node| node["title"] == ProjectBoard::PROJECT_TITLE }
abort "No project titled #{ProjectBoard::PROJECT_TITLE.inspect} under #{owner}" unless project
project_id = project["id"]

field_nodes = graphql(<<~GRAPHQL, id: project_id).dig("node", "fields", "nodes")
  query($id: ID!) {
    node(id: $id) {
      ... on ProjectV2 {
        fields(first: 50) {
          nodes {
            ... on ProjectV2SingleSelectField { id name options { id name } }
            ... on ProjectV2Field { id name }
          }
        }
      }
    }
  }
GRAPHQL
field_nodes = field_nodes.reject(&:empty?)
fields = ProjectBoard.single_select_fields(field_nodes)

items_query = <<~GRAPHQL
  query($id: ID!, $endCursor: String) {
    node(id: $id) {
      ... on ProjectV2 {
        items(first: 100, after: $endCursor) {
          pageInfo { hasNextPage endCursor }
          nodes {
            id
            content {
              __typename
              ... on Issue {
                number title state repository { nameWithOwner } labels(first: 20) { nodes { name } }
                subIssuesSummary { total } parent { number }
              }
            }
            fieldValues(first: 20) {
              nodes {
                ... on ProjectV2ItemFieldSingleSelectValue { name field { ... on ProjectV2FieldCommon { name } } }
                ... on ProjectV2ItemFieldNumberValue { number field { ... on ProjectV2FieldCommon { name } } }
              }
            }
          }
        }
      }
    }
  }
GRAPHQL
pages = JSON.parse(gh("api", "graphql", "--paginate", "--slurp", "-f", "id=#{project_id}", "-f", "query=#{items_query}"))
item_nodes = pages.flat_map { |page| page.dig("data", "node", "items", "nodes") }
issues = ProjectBoard.issues(item_nodes).select { |issue| issue["repository"] == repository["nameWithOwner"] }

def set_single_select(project_id, item_id, field_id, option_id)
  graphql(<<~GRAPHQL, project: project_id, item: item_id, field: field_id, option: option_id)
    mutation($project: ID!, $item: ID!, $field: ID!, $option: String!) {
      updateProjectV2ItemFieldValue(input: {
        projectId: $project, itemId: $item, fieldId: $field, value: { singleSelectOptionId: $option }
      }) { projectV2Item { id } }
    }
  GRAPHQL
end

def set_number(project_id, item_id, field_id, number)
  graphql(<<~GRAPHQL, project: project_id, item: item_id, field: field_id, number: number)
    mutation($project: ID!, $item: ID!, $field: ID!, $number: Float!) {
      updateProjectV2ItemFieldValue(input: {
        projectId: $project, itemId: $item, fieldId: $field, value: { number: $number }
      }) { projectV2Item { id } }
    }
  GRAPHQL
end

def clear_field(project_id, item_id, field_id)
  graphql(<<~GRAPHQL, project: project_id, item: item_id, field: field_id)
    mutation($project: ID!, $item: ID!, $field: ID!) {
      clearProjectV2ItemFieldValue(input: { projectId: $project, itemId: $item, fieldId: $field }) { projectV2Item { id } }
    }
  GRAPHQL
end

# Writes a derived Estimate, or clears it on a parent issue.
def write_estimate(project_id, item_id, field_id, estimate)
  if estimate == ProjectBoard::CLEAR
    clear_field(project_id, item_id, field_id)
  else
    set_number(project_id, item_id, field_id, estimate)
  end
end

def describe_estimate(previous, estimate)
  return "Estimate #{previous} cleared (has sub-issues)" if estimate == ProjectBoard::CLEAR

  "Estimate #{previous ? "#{previous} -> " : ""}#{estimate}"
end

def estimate_field_id(field_nodes)
  ProjectBoard.field_id(field_nodes, ProjectBoard::ESTIMATE_FIELD)
rescue ProjectBoard::Error => error
  abort error.message
end

case command
when "list"
  shown = issues.select { |issue| issue["state"] == "OPEN" }
  shown = shown.select { |issue| ProjectBoard.untriaged?(issue) } unless options.include?("--all")

  # Open issues the board's auto-add has not picked up yet need triage too.
  on_board = issues.map { |issue| issue["number"] }
  missing = JSON.parse(gh("issue", "list", "--state", "open", "--limit", "1000", "--json", "number,title,labels"))
    .reject { |issue| on_board.include?(issue["number"]) }
    .map do |issue|
      { "number" => issue["number"], "title" => issue["title"], "state" => "OPEN",
        "labels" => issue["labels"].map { |label| label["name"] }, "Status" => "not on board" }
    end
  shown += missing

  puts options.include?("--json") ? JSON.pretty_generate(shown.sort_by { |issue| issue["number"] }) : ProjectBoard.format_table(shown)

when "set"
  number = options.shift.to_s
  abort "set needs an issue number\n#{USAGE}" unless number.match?(/\A\d+\z/)
  requested = { "Priority" => option_value(options, "--priority"), "Size" => option_value(options, "--size") }
  abort "set needs --priority, --size, or both\n#{USAGE}" if requested.values.all?(&:nil?)

  issue = issues.find { |candidate| candidate["number"] == number.to_i }
  unless issue
    # Not on the board yet: read it from the repository so a parent issue is
    # still recognised and gets no Estimate.
    owner_name, repository_name = repository["nameWithOwner"].split("/", 2)
    content = graphql(<<~GRAPHQL, owner: owner_name, name: repository_name, number: number.to_i).dig("repository", "issue")
      query($owner: String!, $name: String!, $number: Int!) {
        repository(owner: $owner, name: $name) {
          issue(number: $number) {
            id number title state repository { nameWithOwner } labels(first: 20) { nodes { name } }
            subIssuesSummary { total } parent { number }
          }
        }
      }
    GRAPHQL
    abort "Issue #{number} not found in #{repository["nameWithOwner"]}" unless content
    content_id = content["id"]
    issue = ProjectBoard.issue(content)
  end
  begin
    resolved = requested.compact.to_h { |field, value| [ field, ProjectBoard.option_id(fields, field, value) ] }
    changes = ProjectBoard.changes(issue, requested, force: options.include?("--force"))
  rescue ProjectBoard::Error => error
    abort error.message
  end

  if changes.empty?
    puts "Issue #{number}: already #{requested.compact.map { |field, value| "#{field} #{value}" }.join(", ")}"
    exit
  end

  item_id = issue["item_id"]
  unless item_id
    added = graphql(<<~GRAPHQL, project: project_id, content: content_id)
      mutation($project: ID!, $content: ID!) {
        addProjectV2ItemById(input: { projectId: $project, contentId: $content }) { item { id } }
      }
    GRAPHQL
    item_id = added.dig("addProjectV2ItemById", "item", "id")
    puts "Issue #{number}: added to the #{ProjectBoard::PROJECT_TITLE} board"
  end

  changes.each do |field, value|
    previous = issue[field]
    if field == ProjectBoard::ESTIMATE_FIELD
      write_estimate(project_id, item_id, estimate_field_id(field_nodes), value)
      puts "Issue #{number}: #{describe_estimate(previous, value)}"
    else
      set_single_select(project_id, item_id, *resolved.fetch(field))
      puts "Issue #{number}: #{field} #{previous ? "#{previous} -> " : ""}#{value}"
    end
  end

when "sync-estimates"
  # Every issue on the board, closed ones included, so the Done column totals too.
  stale = issues.filter_map do |issue|
    estimate = ProjectBoard.estimate_change(issue, issue["Size"])
    [ issue, estimate ] if estimate
  end
  if stale.empty?
    puts "Every issue already has the right Estimate."
    exit
  end

  field_id = estimate_field_id(field_nodes) unless options.include?("--dry-run")
  stale.sort_by { |issue, _| issue["number"] }.each do |issue, estimate|
    write_estimate(project_id, issue["item_id"], field_id, estimate) if field_id
    puts "Issue #{issue["number"]}: #{describe_estimate(issue[ProjectBoard::ESTIMATE_FIELD], estimate)} " \
         "(Size #{issue["Size"] || "-"})#{" (dry run)" unless field_id}"
  end
end
