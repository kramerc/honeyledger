#!/usr/bin/env ruby
# frozen_string_literal: true

# Drops development and test databases left behind by worktrees that no longer
# exist. Removing a worktree does not remove the databases bin/worktree-setup
# created for it, so run this occasionally to reclaim them.
#
#   bin/worktree-clean           # list what would be dropped
#   bin/worktree-clean --drop    # drop them

require "shellwords"

APP_ROOT = File.expand_path("..", __dir__)

live_suffixes = `git -C #{APP_ROOT.shellescape} worktree list --porcelain`
  .lines
  .filter_map { |line| line[/\Aworktree (.+)/, 1]&.strip }
  .drop(1) # the primary checkout owns the unsuffixed databases
  .map do |path|
    name = path.include?("/.claude/worktrees/") ? path.split("/.claude/worktrees/", 2).last : File.basename(path)
    name.downcase.gsub(/[^a-z0-9]+/, "_").delete_prefix("_").delete_suffix("_")[0, 30]
  end

query = "SELECT datname FROM pg_database WHERE datname LIKE 'honeyledger_development\\_%' " \
        "OR datname LIKE 'honeyledger_test\\_%' ORDER BY 1"
databases = `psql -tAc #{query.shellescape} postgres`.split("\n").map(&:strip).reject(&:empty?)

orphaned = databases.reject do |database|
  suffix = database.sub(/\Ahoneyledger_(development|test)_/, "")
  live_suffixes.include?(suffix)
end

if orphaned.empty?
  puts "No orphaned worktree databases."
  exit 0
end

if ARGV.include?("--drop")
  orphaned.each do |database|
    system("dropdb", "--if-exists", database) or abort("Failed to drop #{database}")
    puts "Dropped #{database}"
  end
else
  puts "Orphaned worktree databases (re-run with --drop to remove):"
  orphaned.each { |database| puts "  #{database}" }
end
