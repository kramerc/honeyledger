#!/usr/bin/env ruby
# frozen_string_literal: true

# Drops development and test databases left behind by worktrees that no longer
# exist. Removing a worktree does not remove the databases bin/worktree-setup
# created for it, so run this occasionally to reclaim them.
#
#   bin/worktree-clean           # list what would be dropped
#   bin/worktree-clean --drop    # drop them
#
# Only databases recorded in tmp/worktree_databases.json when bin/worktree-setup
# created them are eligible. Databases created any other way -- including by
# setting HONEYLEDGER_DB_SUFFIX by hand -- are never touched, so an unrecognized
# database is always left in place rather than guessed at.
#
# Every step fails closed: this script deletes data, so anything it cannot
# establish for certain aborts rather than proceeding on a guess.

require "shellwords"

APP_ROOT = File.expand_path("..", __dir__)

require File.join(APP_ROOT, "config", "worktree_database")

abort "Run bin/worktree-clean from the primary checkout." if WorktreeDatabase.linked_worktree?(APP_ROOT)

# A failed listing would look like "no worktrees are live", which would classify
# every registered worktree as an orphan and drop databases still in use.
def live_worktrees
  listing = `git -C #{APP_ROOT.shellescape} worktree list --porcelain`
  abort "Could not list git worktrees; refusing to guess which are live." unless $?.success?

  paths = listing.lines.filter_map { |line| line[/\Aworktree (.+)/, 1]&.strip }
  abort "git reported no worktrees at all; refusing to continue." if paths.empty?

  paths
end

# config/database.yml honours DB_HOST (the devcontainer sets it), but psql and
# dropdb would otherwise fall back to libpq's defaults and read or delete from a
# different cluster than the one Rails uses.
PSQL_ENVIRONMENT =
  if ENV["DB_HOST"]
    { "PGHOST" => ENV["DB_HOST"], "PGUSER" => "postgres", "PGPASSWORD" => "postgres" }
  else
    {}
  end

# Likewise, a failed enumeration would look like "none of these databases exist".
def existing_databases
  listing = IO.popen(PSQL_ENVIRONMENT, [ "psql", "-tAc", "SELECT datname FROM pg_database", "postgres" ], &:read)
  abort "Could not query PostgreSQL for existing databases; is it running?" unless $?.success?

  listing.split("\n").map(&:strip).reject(&:empty?)
end

def databases_for(reclaimable, existing)
  reclaimable.flat_map do |worktree_path, suffix|
    %W[honeyledger_development#{suffix} honeyledger_test#{suffix}]
      .select { |database| existing.include?(database) }
      .map { |database| [ worktree_path, database ] }
  end.uniq { |_worktree_path, database| database } # several dead worktrees can share a suffix
end

def report(droppable)
  if droppable.empty?
    puts "No orphaned worktree databases."
  else
    puts "Orphaned worktree databases (re-run with --drop to remove):"
    droppable.each { |worktree_path, database| puts "  #{database}  (was #{worktree_path})" }
  end
end

# A dry run reports and changes nothing at all, including the registry.
unless ARGV.include?("--drop")
  reclaimable = WorktreeDatabase::Registry.reclaimable(WorktreeDatabase::Registry.read(APP_ROOT), live_worktrees)
  report(databases_for(reclaimable, existing_databases))
  exit 0
end

# Decide and act holding the registry lock, and read the live worktrees inside
# it. bin/worktree-setup registers under the same lock, so without this a
# worktree created after the listing was taken -- but registered before the
# registry was read -- would look like an orphan and have its databases dropped.
WorktreeDatabase::Registry.with_lock(APP_ROOT) do
  registry = WorktreeDatabase::Registry.read(APP_ROOT)
  reclaimable = WorktreeDatabase::Registry.reclaimable(registry, live_worktrees)
  droppable = databases_for(reclaimable, existing_databases)

  droppable.each do |_worktree_path, database|
    system(PSQL_ENVIRONMENT, "dropdb", "--if-exists", database) or abort("Failed to drop #{database}")
    puts "Dropped #{database}"
  end

  # Forget every reclaimed worktree, including any whose databases were already
  # gone. Enumeration succeeded, so absence is trustworthy here.
  registry.reject! { |worktree_path, _suffix| reclaimable.key?(worktree_path) }
  WorktreeDatabase::Registry.write(APP_ROOT, registry)

  puts "No orphaned worktree databases." if droppable.empty?
end
