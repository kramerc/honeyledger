<h1>Integrations</h1>

<p><%= link_to "CSV Imports →", csv_imports_path %> — past CSV uploads across all your accounts. Start a new one from any account's transactions page.</p>

<h2>Connections</h2>
<table>
  <tr>
    <th>Service</th>
    <th>Status</th>
    <th>Last Refreshed</th>
    <th style="white-space: nowrap">Actions</th>
  </tr>
  <tr>
    <td>SimpleFIN</td>
    <% if @simplefin_connection %>
      <td>Connected since <%= @simplefin_connection.created_at.strftime("%B %d, %Y") %></td>
      <td><%= @simplefin_connection.refreshed_at ? @simplefin_connection.refreshed_at.strftime("%B %d, %Y %I:%M %p") : "Never" %></td>
      <td style="display: flex; gap: 0.25em; align-items: center">
        <%= button_to "Refresh", refresh_simplefin_connection_path %>
        <%= button_to "Disconnect", simplefin_connection_path, method: :delete, data: { turbo_confirm: "Are you sure you want to disconnect from SimpleFIN?" } %>
      </td>
    <% else %>
      <td colspan="2">Not connected</td>
      <td><%= button_to "Connect", new_simplefin_connection_path, method: :get %></td>
    <% end %>
  </tr>
  <tr>
    <td>Lunch Flow</td>
    <% if @lunchflow_connection %>
      <td>Connected since <%= @lunchflow_connection.created_at.strftime("%B %d, %Y") %></td>
      <td><%= @lunchflow_connection.refreshed_at ? @lunchflow_connection.refreshed_at.strftime("%B %d, %Y %I:%M %p") : "Never" %></td>
      <td style="display: flex; gap: 0.25em; align-items: center">
        <%= button_to "Refresh", refresh_lunchflow_connection_path %>
        <%= button_to "Disconnect", lunchflow_connection_path, method: :delete, data: { turbo_confirm: "Are you sure you want to disconnect from Lunch Flow?" } %>
      </td>
    <% else %>
      <td colspan="2">Not connected</td>
      <td><%= button_to "Connect", new_lunchflow_connection_path, method: :get %></td>
    <% end %>
  </tr>
  <% @blockchain_connections.each do |blockchain_connection| %>
    <tr>
      <td>
        <%= blockchain_connection.name %>
        <span class="marker" title="<%= blockchain_connection.identifier %>"><%= blockchain_connection.display_identifier %></span>
      </td>
      <td>
        <% if blockchain_connection.error.present? %>
          <span class="text-error"><%= blockchain_connection.error %></span>
        <% else %>
          Tracking since <%= blockchain_connection.created_at.strftime("%B %d, %Y") %>
        <% end %>
      </td>
      <td><%= blockchain_connection.refreshed_at ? blockchain_connection.refreshed_at.strftime("%B %d, %Y %I:%M %p") : "Never" %></td>
      <td style="display: flex; gap: 0.25em; align-items: center">
        <%= button_to "Refresh", refresh_blockchain_connection_path(blockchain_connection), "aria-label": "Refresh #{blockchain_connection.name}" %>
        <%= button_to "Edit", edit_blockchain_connection_path(blockchain_connection), method: :get, "aria-label": "Edit #{blockchain_connection.name}" %>
        <%= button_to "Remove", blockchain_connection_path(blockchain_connection), method: :delete, "aria-label": "Remove #{blockchain_connection.name}", data: { turbo_confirm: "Stop tracking this wallet? Its imported ledger transactions stay." } %>
      </td>
    </tr>
  <% end %>
  <tr>
    <td>Bitcoin wallet</td>
    <td colspan="2">Track an address or extended public key from public chain data</td>
    <td><%= button_to "Add wallet", new_blockchain_connection_path, method: :get, params: { chain: "bitcoin" }, "aria-label": "Add Bitcoin wallet" %></td>
  </tr>
  <% if Blockchain::Connection.chain_available?(:ethereum) %>
    <tr>
      <td>Ethereum wallet</td>
      <td colspan="2">Track an address's ETH and gas fees from public chain data</td>
      <td><%= button_to "Add wallet", new_blockchain_connection_path, method: :get, params: { chain: "ethereum" }, "aria-label": "Add Ethereum wallet" %></td>
    </tr>
  <% end %>
</table>

<% if @simplefin_connection %>
  <h2>SimpleFIN Accounts</h2>

  <% if @simplefin_connection.errlist.any? %>
    <h3>Errors</h3>
    <p>SimpleFIN reported the following errors during the last refresh:</p>
    <ul>
      <% @simplefin_connection.errlist.each do |error| %>
        <li><strong><%= error["code"] %></strong>: <%= error["msg"] %></li>
      <% end %>
    </ul>
    <p>Head to <a href="https://beta-bridge.simplefin.org/my-account">My Account on SimpleFIN</a> to resolve them.</p>
  <% end %>

  <% if @simplefin_accounts.any? %>
    <table>
      <tr>
        <th>Organization</th>
        <th>Account Name</th>
        <th style="text-align: right">Balance</th>
        <th>Currency</th>
        <th>Balance As Of</th>
        <th>Linked Account</th>
      </tr>
      <% @simplefin_accounts.each do |sf_account| %>
        <tr>
          <td><%= sf_account.institution_name %></td>
          <td>
            <%= sf_account.name %>
            <% unless sf_account.current?(@simplefin_connection.refreshed_at) %>
              <span class="marker" title="This account did not appear in the most recent refresh. It may have been re-issued or disconnected on the aggregator side.">(stale)</span>
            <% end %>
          </td>
          <td style="text-align: right; white-space: nowrap"><%= aggregator_balance(sf_account) %></td>
          <td><%= aggregator_currency(sf_account) %></td>
          <td style="white-space: nowrap"><%= sf_account.balance_date ? sf_account.balance_date.strftime("%B %d, %Y %I:%M %p") : "—" %></td>
          <td><%= render partial: "integrations/simplefin_link_form", locals: { sf_account: sf_account, linkable_accounts: @linkable_accounts } %></td>
        </tr>
      <% end %>
    </table>
  <% else %>
    <p>No accounts found. Try refreshing your connection.</p>
  <% end %>
<% end %>

<% if @lunchflow_connection %>
  <h2>Lunch Flow Accounts</h2>

  <% if @lunchflow_connection.error.present? %>
    <h3>Error</h3>
    <p><%= @lunchflow_connection.error %></p>
  <% end %>

  <% if @lunchflow_accounts.any? %>
    <table>
      <tr>
        <th>Institution</th>
        <th>Account Name</th>
        <th style="text-align: right">Balance</th>
        <th>Currency</th>
        <th>Balance As Of</th>
        <th>Status</th>
        <th>Linked Account</th>
      </tr>
      <% @lunchflow_accounts.each do |lf_account| %>
        <tr>
          <td><%= lf_account.institution_name %></td>
          <td>
            <%= lf_account.name %>
            <% unless lf_account.current?(@lunchflow_connection.refreshed_at) %>
              <span class="marker" title="This account did not appear in the most recent refresh. It may have been re-issued or disconnected on the aggregator side.">(stale)</span>
            <% end %>
          </td>
          <td style="text-align: right; white-space: nowrap"><%= aggregator_balance(lf_account) %></td>
          <td><%= aggregator_currency(lf_account) %></td>
          <td style="white-space: nowrap"><%= lf_account.balance_changed_at ? lf_account.balance_changed_at.strftime("%B %d, %Y %I:%M %p") : "—" %></td>
          <td>
            <% case lf_account.status %>
            <% when "ACTIVE" %>
              <span style="color: green"><%= lf_account.status %></span>
            <% when "ERROR" %>
              <span class="text-error"><%= lf_account.status %> - resolve on <a href="https://lunchflow.app">Lunch Flow</a></span>
            <% when "DISCONNECTED" %>
              <span class="text-error"><%= lf_account.status %> - reconnect on <a href="https://lunchflow.app">Lunch Flow</a></span>
            <% else %>
              <%= lf_account.status %>
            <% end %>
          </td>
          <td><%= render partial: "integrations/lunchflow_link_form", locals: { lf_account: lf_account, linkable_accounts: @linkable_accounts } %></td>
        </tr>
      <% end %>
    </table>
  <% else %>
    <p>No accounts found. Try refreshing your connection.</p>
  <% end %>
<% end %>

<% if @blockchain_connections.any? %>
  <h2>Wallet Accounts</h2>

  <% if @blockchain_accounts.any? %>
    <table>
      <tr>
        <th>Wallet</th>
        <th>Asset</th>
        <th style="text-align: right">Balance</th>
        <th>Currency</th>
        <th>Balance As Of</th>
        <th>Linked Account</th>
      </tr>
      <% @blockchain_accounts.each do |blockchain_account| %>
        <tr>
          <td><%= blockchain_account.institution_name %></td>
          <td><%= blockchain_account.name %></td>
          <td style="text-align: right; white-space: nowrap"><%= aggregator_balance(blockchain_account) %></td>
          <td><%= aggregator_currency(blockchain_account) %></td>
          <td style="white-space: nowrap"><%= blockchain_account.balance_changed_at ? blockchain_account.balance_changed_at.strftime("%B %d, %Y %I:%M %p") : "—" %></td>
          <td><%= render partial: "integrations/blockchain_link_form", locals: { blockchain_account: blockchain_account, linkable_accounts: @linkable_accounts } %></td>
        </tr>
      <% end %>
    </table>
  <% else %>
    <p>No wallet history yet. It appears after the first refresh finishes.</p>
  <% end %>
<% end %>
