<% if blockchain_account.unlinked? %>
  <%= form_with model: blockchain_account, url: link_blockchain_account_path(blockchain_account), method: :post do |form| %>
    <%= form.label :ledger_account_id, "Account to link", class: "sr-only" %>
    <span>
      <%= form.select :ledger_account_id, grouped_account_options_for_select(linkable_accounts.select { |account| blockchain_account.linkable_to?(account) }, Account.kinds.keys), { include_blank: "Not linked" } %>
    </span>
    <span>
      <%= form.submit "Link", "aria-label": "Link wallet account" %>
    </span>
    <span>
      <%= link_to "Import", new_account_path(blockchain_account_id: blockchain_account.id) %>
    </span>
  <% end %>
<% else %>
  <%= form_with model: blockchain_account, url: unlink_blockchain_account_path(blockchain_account), method: :delete, data: { turbo_confirm: "Are you sure you want to unlink this account?" } do |form| %>
    <span><%= blockchain_account.ledger_account.name %></span>
    <span>
      <%= form.submit "Unlink", "aria-label": "Unlink wallet account" %>
    </span>
  <% end %>
<% end %>
