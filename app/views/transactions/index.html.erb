<% content_for :title, "Transactions" %>

<h1 class="sr-only">Transactions</h1>

<div class="transactions-filter">
  <% if @show_excluded %>
    <%= link_to "Hide excluded transactions", transactions_page_path(account: @account, show_excluded: false) %>
  <% else %>
    <%= link_to "Show excluded transactions", transactions_page_path(account: @account, show_excluded: true) %>
  <% end %>
  <% if @account&.real? %>
    | <%= link_to "Import CSV", account_csv_imports_path(@account) %>
  <% end %>
</div>

<div data-controller="transactions--selection">
  <div class="transactions" data-controller="disclosure" data-disclosure-open-class="transactions--composing">
    <%# Phones keep the new-transaction form folded away behind this button;
        on wider screens it is hidden and the form is always shown. %>
    <button type="button" class="new-transaction-toggle" aria-controls="new_transaction" aria-expanded="false"
            data-disclosure-target="button" data-action="disclosure#toggle">New transaction</button>

    <div class="row header">
      <div></div>
      <div>Date</div>
      <div>Type</div>
      <div>Description</div>
      <div>From</div>
      <div>To</div>
      <div>Amount</div>
      <div>Currency</div>
      <div>Category</div>
      <div>Cleared</div>
      <div><span class="sr-only">Actions</span></div>
    </div>

    <%= turbo_frame_tag :new_transaction do %>
      <%= render partial: 'form', locals: {
        transaction: @new_transaction,
        accounts: @accounts,
        categories: @categories,
        filter_account: @account
      } %>
    <% end %>

    <%= turbo_frame_tag :transactions do %>
      <%= render "page", transactions: @transactions, next_cursor: @next_cursor %>
    <% end %>
  </div>

  <%= render "selection_bar", categories: @categories, show_excluded: @show_excluded, filter_account: @account %>
</div>
