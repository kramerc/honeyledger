<!-- Show -->
<%# Aggregated source rows for this row's chips: the transaction's own sources plus,
    for a merge result, those of every merged origin (the result itself is created
    sourceless). Resolution and N+1-safety live in Transaction#badge_transaction_sources. %>
<% sources = transaction.badge_transaction_sources %>
<%= turbo_frame_tag transaction do %>
  <div class="transaction" data-controller="transactions--row" data-transactions--row-id-value="<%= transaction.id %>"
       data-page-cursor="<%= Transaction::Page::Cursor.after(transaction).to_params.to_query %>"
       data-selection-excluded="<%= transaction.excluded? %>"
       data-selection-excludable="<%= transaction.excludable? %>"
       data-merge-amount-minor="<%= transaction.amount_minor %>"
       data-merge-src-account-id="<%= transaction.src_account_id %>"
       data-merge-dest-account-id="<%= transaction.dest_account_id %>"
       data-merge-src-kind="<%= transaction.src_account&.kind %>"
       data-merge-dest-kind="<%= transaction.dest_account&.kind %>"
       data-merge-src-account-name="<%= transaction.src_account&.name %>"
       data-merge-dest-account-name="<%= transaction.dest_account&.name %>"
       data-merge-description="<%= transaction.description %>"
       data-merge-category="<%= transaction.category&.name %>"
       data-merge-has-fx="<%= transaction.has_fx? %>"
       data-merge-split="<%= transaction.split? || transaction.parent_transaction_id? %>"
       data-merge-merge-result="<%= transaction.merged_sources.any? %>"
       data-merge-origin-src-account-ids="<%= transaction.merged_sources.map(&:src_account_id).join(",") %>"
       data-merge-origin-dest-account-ids="<%= transaction.merged_sources.map(&:dest_account_id).join(",") %>"
       data-merge-transacted-at="<%= transaction.transacted_at&.strftime("%Y-%m-%dT%H:%M") %>"
       data-merge-currency-code="<%= transaction.currency.code %>"
       data-merge-currency-decimal-places="<%= transaction.currency.decimal_places %>">

    <div class="row show">
      <div class="select">
        <% unless transaction.opening_balance? %>
          <input type="checkbox"
                 class="selection-checkbox"
                 data-transactions--selection-target="checkbox"
                 data-action="change->transactions--selection#toggle"
                 data-transaction-id="<%= transaction.id %>">
        <% end %>
      </div>
      <div data-label="Date" class="date-cell">
        <%= transaction_date_field(transaction) %>
        <% if sources.any? %>
          <div class="source-badges">
            <%= transaction_source_badges(sources) %>
          </div>
        <% end %>
      </div>
      <div data-label="Type">
        <%= transaction_type_indicator(transaction) %>
        <% if transaction.excluded? %>
          <span class="excluded-badge" title="Excluded from calculations">Excluded</span>
        <% elsif transaction.merged_sources.any? %>
          <a href="#" class="merged-badge" data-action="transactions--row#toggleMergedDetails">Merged</a>
        <% end %>
      </div>
      <div data-label="Description" class="description-cell"><%= transaction_description_field(transaction) %></div>
      <div data-label="From" class="account-cell"><%= transaction_account_field(transaction, :src) %></div>
      <div data-label="To" class="account-cell account-cell--to"><%= transaction_account_field(transaction, :dest) %></div>
      <div data-label="Amount" class="numeric amount-cell"><%= transaction_amount_field(transaction) %></div>
      <div data-label="Currency"><%= transaction.currency.code %></div>
      <div data-label="Category" class="category-cell"><%= transaction_category_field(transaction) %></div>
      <div data-label="Cleared" class="boolean cleared-cell"><%= transaction_cleared_field(transaction) %></div>
      <div class="actions" data-controller="menu">
        <% menu_id = dom_id(transaction, :actions_menu) %>
        <%# The anchor name ties the menu to its trigger for CSS anchor positioning (menu.css). %>
        <button type="button" class="menu-trigger" popovertarget="<%= menu_id %>"
                aria-haspopup="menu" aria-expanded="false" aria-label="Transaction actions"
                style="anchor-name: --<%= menu_id %>"
                data-menu-target="trigger">
          <%= lucide_icon "ellipsis-vertical", size: 16 %>
        </button>
        <div id="<%= menu_id %>" class="menu" popover role="menu" aria-label="Transaction actions"
             style="position-anchor: --<%= menu_id %>"
             data-menu-target="menu"
             data-action="beforetoggle->menu#beforeToggled toggle->menu#toggled keydown->menu#navigate click->menu#close">
          <% if transaction.opening_balance? && transaction.opening_balance_target_account.present? %>
            <%= link_to "Edit Account", edit_account_path(transaction.opening_balance_target_account), role: "menuitem", data: { turbo_frame: "_top" } %>
          <% else %>
            <a href="#" role="menuitem" data-action="transactions--row#edit">Edit</a>
          <% end %>
          <%# account_id keeps the index's account filter attached to the row, so the
              responses can scope their Turbo Stream targets to the list on screen.
              Rails omits the param when the index is unfiltered. %>
          <% if transaction.excluded? %>
            <%= link_to "Restore", unexclude_transaction_path(transaction, account_id: @account&.id), role: "menuitem", data: { turbo_method: :post } %>
          <% elsif transaction.excludable? %>
            <%= link_to "Exclude", exclude_transaction_path(transaction, account_id: @account&.id), role: "menuitem", data: { turbo_method: :post, turbo_confirm: "Exclude this transaction? It will be hidden from calculations but not reimported." } %>
          <% end %>
          <% if transaction.merged_sources.any? %>
            <%= link_to "Unmerge", unmerge_transaction_path(transaction, account_id: @account&.id), role: "menuitem", data: { turbo_method: :post, turbo_confirm: "Unmerge this transfer back into the original transactions?" } %>
          <% end %>
          <hr class="menu__separator">
          <%= link_to "Delete", transaction, role: "menuitem", class: "menu__item--danger", data: { turbo_method: :delete, turbo_confirm: "Delete this transaction?", turbo_frame: dom_id(transaction) } %>
        </div>
      </div>

      <% if transaction.merged_sources.any? %>
        <div class="merged-details" data-transactions--row-target="mergedDetails">
          <div class="merged-details__content">
            <strong>Merged from:</strong>
            <ul>
              <% transaction.merged_sources.each do |source| %>
                <% origin_sources = source.own_badge_sources %>
                <li><%= source.src_account&.name %> → <%= source.dest_account&.name %><% if source.description.present? %> — "<%= source.description %>"<% end %><%= transaction_source_badges(origin_sources) if origin_sources.any? %></li>
              <% end %>
            </ul>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Edit -->
    <%# account_id rides along so the edit form posts it back and the replaced row
        keeps its action links scoped to the list on screen. %>
    <%# Empty until loaded: the shown row stays on screen, marked busy, until the
        form arrives (transactions.css), so the row's height doesn't change. %>
    <%= turbo_frame_tag dom_id(transaction, :edit), src: edit_transaction_path(transaction, account_id: @account&.id, standalone: (1 if @standalone)), loading: "lazy", class: "edit" %>
  </div>
<% end %>
