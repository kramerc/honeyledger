<h1>Settings</h1>

<h2>Passkeys</h2>

<p>Passkeys let you log in with your device's screen lock or a security key instead of typing a password. Your password keeps working alongside them.</p>

<% if @passkeys.any? %>
  <div class="passkeys">
    <div class="row header">
      <div>Name</div>
      <div>Added</div>
      <div>Last Used</div>
      <div>Actions</div>
    </div>
    <% @passkeys.each do |passkey| %>
      <div id="<%= dom_id(passkey) %>" class="row">
        <div data-label="Name"><%= passkey.nickname %></div>
        <div data-label="Added"><%= passkey.created_at.strftime("%B %d, %Y") %></div>
        <div data-label="Last Used"><%= passkey.last_used_at ? passkey.last_used_at.strftime("%B %d, %Y %I:%M %p") : "Never" %></div>
        <div class="actions">
          <%= link_to "Rename", edit_passkey_path(passkey), "aria-label": "Rename #{passkey.nickname}" %>
          <%= button_to "Delete", passkey_path(passkey), method: :delete, "aria-label": "Delete #{passkey.nickname}", data: { turbo_confirm: "Remove the passkey \"#{passkey.nickname}\"? You can still log in with your password." } %>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <p>No passkeys yet.</p>
<% end %>

<h3>Add a passkey</h3>

<% if !passkeys_available? %>
  <p>Passkeys are not configured for this deployment.</p>
<% elsif recently_authenticated? %>
  <div data-controller="passkey" data-passkey-options-url-value="<%= options_passkeys_path %>" data-passkey-submit-url-value="<%= passkeys_path %>">
    <form data-passkey-target="form" data-action="submit->passkey#register">
      <div>
        <label for="passkey_nickname" style="display: block">Name (optional)</label>
        <input type="text" id="passkey_nickname" maxlength="64" data-passkey-target="nickname">
        <br><small>Leave it blank to name the passkey after the password manager or browser that creates it. You can rename it later.</small>
      </div>

      <div>
        <button type="submit" data-passkey-target="button">Add passkey</button>
      </div>
    </form>

    <p data-passkey-target="error" role="alert" style="color: var(--color-negative)" hidden></p>
    <p data-passkey-target="unsupported" hidden>This browser does not support passkeys.</p>
  </div>
<% else %>
  <p><%= link_to "Confirm your password to add a passkey", new_reauthentication_path %></p>
<% end %>
