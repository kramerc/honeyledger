{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "setup=\"${CLAUDE_PROJECT_DIR:-.}/bin/worktree-setup\"; [ -x \"$setup\" ] && \"$setup\" || true",
            "timeout": 300,
            "statusMessage": "Preparing worktree databases"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "enabledPlugins": {
    "github@claude-plugins-official": true,
    "ruby-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "code-review@claude-plugins-official": true
  }
}
